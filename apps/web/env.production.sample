# Copy to .env.production for docker compose prod builds
NEXT_PUBLIC_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_API_BASE=https://api.memeplace.xyz
NEXT_PUBLIC_SOCKET_URL=wss://api.memeplace.xyz/ws
NEXT_PUBLIC_MEME_MINT=MintAddressHere
NEXT_PUBLIC_PIXEL_COST=1000

# Maintenance mode - set to 'true' during token launches to block user activity
# NEXT_PUBLIC_MAINTENANCE_MODE=true
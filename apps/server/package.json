{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node scripts/migrate-sql.js && node dist/index.js",
    "migrate": "pnpm run migrate:sql",
    "migrate:sql": "node scripts/migrate-sql.js",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "healthcheck": "node scripts/healthcheck.js"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/websocket": "^10.0.0",
    "@memeplace/shared": "file:../../packages/shared",
    "@solana/spl-token": "^0.4.6",
    "@solana/web3.js": "^1.96.6",
    "bs58": "^6.0.0",
    "fastify": "^4.28.1",
    "fastify-plugin": "^4.5.1",
    "fastify-type-provider-zod": "^1.0.0",
    "pg": "^8.12.0",
    "pino": "^9.2.0",
    "redis": "^4.7.0",
    "tweetnacl": "^1.0.3",
    "ws": "^8.18.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bs58": "^4.0.3",
    "@types/node": "^22.5.1",
    "@types/pg": "^8.15.5",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^7.16.1",
    "@typescript-eslint/parser": "^7.16.1",
    "eslint": "^8.57.0",
    "testcontainers": "^10.9.0",
    "ts-node": "^10.9.2",
    "tsup": "^8.2.2",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^1.6.0"
  }
}

{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "../..",
    "module": "commonjs",
    "target": "ES2022",
    "baseUrl": "./",
    "paths": {
      "@memeplace/shared": ["../../packages/shared/src/index"],
      "@memeplace/shared/*": ["../../packages/shared/src/*"]
    },
    "types": ["vitest/globals"],
    "moduleResolution": "node"
  },
  "include": ["src/**/*.ts", "../../packages/shared/src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}

